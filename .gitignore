# ============================================================
# .gitignore - 音乐语料数据集项目
# 核心原则：数据集、模型权重、音频、日志、密钥 绝对不提交 git
# ============================================================

# ========== 音频文件（大文件，绝对不提交） ==========
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac
*.wma
*.aiff
*.opus

# ========== 模型权重（大文件，绝对不提交） ==========
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.h5
*.pb
*.onnx
*.pkl
*.pickle
models/
# 允许 .gitkeep 保留目录结构
!models/.gitkeep

# ========== 数据目录（音频/大文件部分，不提交） ==========
# 原始音频
data/00_raw_collect/raw_audio/

# 拒绝入库的音频
data/00_raw_collect/rejected/

# 源压缩包
data/00_raw_collect/source_archive/

# 预处理后音频
data/01_preprocess/processed_audio/
data/01_preprocess/processed_master/
data/01_preprocess/segments/
data/01_preprocess/demucs_stems/

# 清洗后音频
data/00.5_cleaned/audio/

# 可重新生成的质量/QC报告（数据产物，不纳入版本控制）
data/00.5_cleaned/reports/
data/00.5_cleaned/dedup_mapping.csv
data/00.5_cleaned/duplicate_pairs.csv
# 注意: cleaned_manifest.csv 保留（清洗后清单，是数据血缘关键节点）

# 模型推理输出缓存（大）
data/02_preannotation/model_output_cache/

# 人工标注备份（可能包含敏感信息）
data/03_human_review/backups/

# 最终数据集音频
data/04_final_dataset/final_audio/

# 并发锁文件
data/.pipeline_lock
*.pipeline_lock

# 数据集版本软链接（软链接无法提交，显式忽略）
data/04_final_dataset/latest

# ========== GPU 快照（不提交，只保留配置） ==========
snapshots/gpu_backup_*/
# 注意：以下配置文件需要提交（显式放行）
!snapshots/README.md
!snapshots/snapshot_retention.toml

# ========== 日志（不提交） ==========
logs/
*.log
# 允许 .gitkeep 保留目录结构
!logs/.gitkeep

# ========== Jupyter 缓存 ==========
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ========== Python 缓存 ==========
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# ========== 环境、密钥（绝对不提交） ==========
.env
*.env
*.local
*.secret
*.key
*.pem
*.pub
secrets/

# ========== IDE / 编辑器 ==========
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ========== macOS 系统文件 ==========
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ========== Conda / 虚拟环境 ==========
*.conda
venv/
.venv/
env/
ENV/

# ========== Label Studio ==========
label_studio.sqlite3
*.sqlite3
*.db
*.sqlite

# ========== 压缩包 ==========
*.zip
*.tar.gz
*.tar
*.rar
*.7z
data/00_raw_collect/source_archive/

# ========== 可视化报告（HTML 可重新生成，不提交大文件） ==========
# 手动生成的可视化（可能很大，如23MB音频特征图）
reports/manual/*.html
reports/manual/**/*.html
# ETL 流水线自动生成的报告（版本化，通常较小，可保留）
# 如需忽略，取消下面两行注释
# reports/etl_report_*/*.html
# reports/etl_report_*/**/*.html
# 允许 .gitkeep 保留目录结构
!reports/manual/.gitkeep
!reports/.gitkeep

# ========== dev 版本 wheel 缓存（必须提交，保证复现） ==========
# essentia / madmom-onnx 是 dev 预览版，PyPI 随时可能移除
# 下载到本地 wheel_cache 并提交 git，保证环境可复现
!envs/wheel_cache/**

# ========== 敏感信息（含密码/API key，禁止提交） ==========
# 注意：docs/gpu_access.md 不含密码，是运维文档，必须被Git跟踪
# .env 含API key，禁止提交
.env
.env.*
!.env.example

# ========== 可重新生成的预标注派生产物（不提交Git） ==========
# L1 物理特征（可从母版重新提取）
data/02_preannotation/l1_physical/
# L2 MERT嵌入（可从母版重新提取）
data/02_preannotation/l2_embedding/
# L2 CLAP语义（可从母版重新提取）
data/02_preannotation/l2_semantic/
# L4 KNN传播标签（可从L2+黄金集重新生成）
data/02_preannotation/l4_propagated/
# Stage6 训练特征（可从切片重新提取）
data/stage6_features/
# 训练切片（可从母版重新生成）
data/05_training_segments/
# 注意: audio_manifest.csv 必须保留Git跟踪（数据血缘骨架）
# 注意: data/04_final_dataset/splits/ 必须保留Git跟踪（划分结果）
# 注意: data/02_preannotation/ls_preannotations.jsonl 保留（Label Studio预标注）
