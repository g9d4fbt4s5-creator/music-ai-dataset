# ============================================================
# Dockerfile.gpu — AI音乐数据集流水线 · GPU特征提取主镜像
# ============================================================
# 基础镜像：PyTorch 2.2.2 + CUDA 12.1 + cuDNN 8（runtime版，体积小）
# 包含：Python 3.10 + torch 2.2.2 + torchaudio 2.2.2
FROM pytorch/pytorch:2.2.2-cuda12.1-cudnn8-runtime

# 维护者信息
LABEL maintainer="简酩迪 <music-ai-dataset@example.com>"
LABEL description="AI音乐数据集处理流水线 - GPU特征提取镜像"
LABEL version="1.0.0"

# ============================================================
# 系统依赖
# ============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \                          # 音频转码（格式标准化）
    chromaprint-tools \               # fpcalc（音频指纹去重）
    git \                             # 代码拉取
    curl \                            # 下载工具
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# Python 依赖（按安装顺序，避免版本冲突）
# ============================================================

# 第一阶段：基础科学计算库
RUN pip install --no-cache-dir \
    numpy==1.26.4 \
    pandas==2.2.3 \
    scikit-learn==1.5.1 \
    plotly==5.22.0

# 第二阶段：音频处理库
RUN pip install --no-cache-dir \
    librosa==0.10.2.post1 \
    soundfile==0.12.1 \
    pyloudnorm==0.1.1 \
    pyacoustid==1.3.0

# 第三阶段：深度学习相关
RUN pip install --no-cache-dir \
    transformers==4.40.2 \
    huggingface_hub==0.23.0 \
    accelerate==0.30.1 \
    datasets==2.19.1

# 第四阶段：音乐AI专用模型
RUN pip install --no-cache-dir \
    demucs==3.0.6 \                  # 源分离（vocals/drums/bass/other）
    laion_clap==1.1.7 \              # CLAP音频-文本对齐嵌入
    openai-whisper==20240930 \       # Whisper语言检测+ASR
    torchcrepe==0.0.23 \             # 基频检测
    torchlibrosa==0.1.0              # 音频特征提取（pytorch版）

# 第五阶段：可选ASR（中文歌词转写）
# 注意：funasr和faster-whisper体积较大，如不需要可注释掉
RUN pip install --no-cache-dir \
    funasr==1.0.0 \                  # 中文歌唱ASR（FunASR）
    faster-whisper==1.0.3 \          # 非中文ASR（更快的Whisper）
    || echo "⚠️  funasr/faster-whisper安装失败，可在运行时手动安装"

# 第六阶段：MIR评测 + API依赖 + 配置工具
RUN pip install --no-cache-dir \
    essentia==2.1b6.dev1110 \       # 音频特征提取（BPM/调性/节拍）
    madmom==0.16.1 \                 # 节拍/onset检测（深度学习）
    mir_eval==0.8 \                   # MIR标准评测库（BPM/f0/onset误差）
    requests==2.32.3 \                # HTTP客户端（DeepSeek/Qwen API调用）
    pyyaml==6.0.2 \                   # YAML配置文件读取
    paramiko==3.4.0 \                 # SSH客户端（Mac-GPU通信，可选）
    || echo "⚠️  essentia/madmom/mir_eval安装失败，可在运行时手动安装"

# ============================================================
# 工作目录与代码
# ============================================================
WORKDIR /app

# 拷贝项目代码（.dockerignore排除了数据/模型/日志等大文件）
COPY scripts/ /app/scripts/
COPY configs/ /app/configs/
COPY docs/ /app/docs/
COPY README.md /app/README.md
COPY PROJECT_STRUCTURE.md /app/PROJECT_STRUCTURE.md

# ============================================================
# 环境变量
# ============================================================
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# 数据目录（挂载用，不打进镜像）
# 使用时：docker run -v /your/data/path:/data ...
VOLUME ["/data"]

# ============================================================
# 健康检查（验证关键依赖是否可用）
# ============================================================
RUN python -c "
import torch
import torchaudio
import transformers
import librosa
import soundfile
import demucs
import whisper
import essentia
import madmom
import mir_eval
import requests
import yaml
print('✅ 所有核心依赖导入成功')
print(f'   torch: {torch.__version__}')
print(f'   torchaudio: {torchaudio.__version__}')
print(f'   transformers: {transformers.__version__}')
print(f'   librosa: {librosa.__version__}')
print(f'   essentia: {essentia.__version__}')
print(f'   madmom: {madmom.__version__}')
print(f'   mir_eval: {mir_eval.__version__}')
print(f'   CUDA available: {torch.cuda.is_available()}')
" || echo "⚠️  依赖检查失败（可能是CUDA环境问题，不影响镜像构建）"

# ============================================================
# 默认入口
# ============================================================
# 使用示例：
#   nvidia-docker run --rm -v /path/to/data:/data music-corpus-gpu:latest \
#       python scripts/01_preprocess/04_extract_features.py --input /data/manifest.csv
#
# 进入交互模式：
#   nvidia-docker run -it --rm -v /path/to/data:/data music-corpus-gpu:latest bash
ENTRYPOINT ["python"]
CMD ["--help"]
