# ============================================================
# Dockerfile.yamnet — YAMNet音频分类专用镜像（TensorFlow）
# ============================================================
# 为什么单独一个镜像？
#   - YAMNet用TensorFlow 2.15，和主镜像的PyTorch环境可能冲突
#   - numpy版本要求不同（YAMNet需要numpy<1.26，主镜像用1.26.4）
#   - 独立镜像更干净，互不干扰
#
# 基础镜像：TensorFlow 2.15.0 + GPU支持
FROM tensorflow/tensorflow:2.15.0-gpu

# 维护者信息
LABEL maintainer="简酩迪 <music-ai-dataset@example.com>"
LABEL description="YAMNet音频分类专用镜像 - TensorFlow 2.15"
LABEL version="1.0.0"

# ============================================================
# 系统依赖
# ============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \                          # 音频解码
    git \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# Python 依赖
# ============================================================
# 注意：numpy必须<1.26，否则TF 2.15会有兼容性问题
RUN pip install --no-cache-dir \
    numpy==1.24.4 \
    pandas==2.1.4 \
    librosa==0.10.2.post1 \
    soundfile==0.12.1 \
    tensorflow-hub==0.15.0 \
    scikit-learn==1.3.2

# ============================================================
# 工作目录与代码
# ============================================================
WORKDIR /app

# 只拷贝YAMNet相关脚本（减少镜像体积）
COPY scripts/00.5_cleaning/yamnet_infer.py /app/scripts/00.5_cleaning/
COPY scripts/utils/get_audio_physical_path.py /app/scripts/utils/
COPY configs/ /app/configs/

# ============================================================
# 环境变量
# ============================================================
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# 数据目录（挂载用）
VOLUME ["/data"]

# ============================================================
# 健康检查
# ============================================================
RUN python -c "
import tensorflow as tf
import tensorflow_hub as hub
import numpy as np
import librosa
print('✅ YAMNet环境依赖导入成功')
print(f'   tensorflow: {tf.__version__}')
print(f'   tensorflow-hub: {hub.__version__}')
print(f'   numpy: {np.__version__}')
print(f'   CUDA available: {tf.config.list_physical_devices(\"GPU\")}')
" || echo "⚠️  依赖检查失败（可能是CUDA环境问题）"

# ============================================================
# 默认入口
# ============================================================
# 使用示例：
#   nvidia-docker run --rm -v /path/to/data:/data music-corpus-yamnet:latest \
#       scripts/00.5_cleaning/yamnet_infer.py --input /data/manifest.csv
#
# 进入交互模式：
#   nvidia-docker run -it --rm -v /path/to/data:/data music-corpus-yamnet:latest bash
ENTRYPOINT ["python"]
CMD ["--help"]
