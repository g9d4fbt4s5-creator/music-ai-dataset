#!/usr/bin/env bash
# ============================================================
# pre-commit - Git 提交前检查钩子
# 防止误提交大文件、密钥、音频、模型权重
# ============================================================
# 安装方法：
#   bash scripts/git_hooks/install_hooks.sh
#
# 手动跳过检查（不推荐）：
#   git commit --no-verify
# ============================================================

set -e

# 颜色定义
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# 阈值配置
WARN_SIZE_MB=10    # 超过 10MB 警告
BLOCK_SIZE_MB=50   # 超过 50MB 阻止提交

# 获取暂存区文件列表
staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged_files" ]; then
    exit 0
fi

echo "========================================"
echo "  Git Pre-commit 检查"
echo "========================================"

errors=0
warnings=0

# ========== 检查 1：大文件 ==========
echo ""
echo "[1/4] 检查大文件..."
while IFS= read -r file; do
    if [ -z "$file" ] || [ ! -f "$file" ]; then
        continue
    fi

    file_size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo 0)
    file_size_mb=$((file_size / 1024 / 1024))

    if [ "$file_size_mb" -ge "$BLOCK_SIZE_MB" ]; then
        echo -e "  ${RED}❌ 阻止提交: $file (${file_size_mb}MB, 超过 ${BLOCK_SIZE_MB}MB 限制)${NC}"
        errors=$((errors + 1))
    elif [ "$file_size_mb" -ge "$WARN_SIZE_MB" ]; then
        echo -e "  ${YELLOW}⚠️  警告: $file (${file_size_mb}MB, 超过 ${WARN_SIZE_MB}MB)${NC}"
        warnings=$((warnings + 1))
    fi
done <<< "$staged_files"

# ========== 检查 2：密钥文件 ==========
echo ""
echo "[2/4] 检查密钥文件..."
secret_patterns=("\.env$" "\.env\." "\.key$" "\.pem$" "\.p12$" "\.pfx$" "\.secret$" "id_rsa" "id_ed25519")

while IFS= read -r file; do
    if [ -z "$file" ]; then
        continue
    fi

    for pattern in "${secret_patterns[@]}"; do
        if echo "$file" | grep -qE "$pattern"; then
            # 例外：.env.example 是模板，可以提交
            if echo "$file" | grep -q "\.env\.example"; then
                continue
            fi
            echo -e "  ${RED}❌ 阻止提交: $file (疑似密钥文件)${NC}"
            echo -e "  ${RED}   密钥应存储在 ~/.config/music-corpus/.env，不要提交到 git${NC}"
            errors=$((errors + 1))
            break
        fi
    done
done <<< "$staged_files"

# ========== 检查 3：音频文件 ==========
echo ""
echo "[3/4] 检查音频文件..."
audio_extensions=("wav" "mp3" "flac" "ogg" "m4a" "aac" "wma" "aiff" "opus")

while IFS= read -r file; do
    if [ -z "$file" ]; then
        continue
    fi

    ext="${file##*.}"
    ext_lower=$(echo "$ext" | tr '[:upper:]' '[:lower:]')

    for audio_ext in "${audio_extensions[@]}"; do
        if [ "$ext_lower" = "$audio_ext" ]; then
            echo -e "  ${RED}❌ 阻止提交: $file (音频文件，应存储在本地/OSS，不提交 git)${NC}"
            errors=$((errors + 1))
            break
        fi
    done
done <<< "$staged_files"

# ========== 检查 4：模型权重文件 ==========
echo ""
echo "[4/4] 检查模型权重文件..."
model_extensions=("pt" "pth" "bin" "safetensors" "ckpt" "h5" "pb" "onnx")

while IFS= read -r file; do
    if [ -z "$file" ]; then
        continue
    fi

    ext="${file##*.}"
    ext_lower=$(echo "$ext" | tr '[:upper:]' '[:lower:]')

    for model_ext in "${model_extensions[@]}"; do
        if [ "$ext_lower" = "$model_ext" ]; then
            # 例外：envs/wheel_cache/ 下的 wheel 包可以提交
            if echo "$file" | grep -q "envs/wheel_cache/"; then
                continue
            fi
            echo -e "  ${RED}❌ 阻止提交: $file (模型权重文件，应存储在本地/OSS，不提交 git)${NC}"
            errors=$((errors + 1))
            break
        fi
    done
done <<< "$staged_files"

# ========== 汇总结果 ==========
echo ""
echo "========================================"
if [ "$errors" -gt 0 ]; then
    echo -e "  ${RED}❌ 提交被阻止: $errors 个错误, $warnings 个警告${NC}"
    echo ""
    echo "  解决方法："
    echo "    1. 将大文件/音频/模型权重添加到 .gitignore"
    echo "    2. 密钥文件移到 ~/.config/music-corpus/.env"
    echo "    3. 运行 git reset HEAD <file> 取消暂存"
    echo ""
    echo "  如确认要跳过检查（不推荐）："
    echo "    git commit --no-verify"
    echo "========================================"
    exit 1
else
    if [ "$warnings" -gt 0 ]; then
        echo -e "  ${YELLOW}⚠️  提交通过: 0 个错误, $warnings 个警告${NC}"
    else
        echo -e "  ${GREEN}✅ 提交通过: 0 个错误, 0 个警告${NC}"
    fi
    echo "========================================"
    exit 0
fi
